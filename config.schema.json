{
  "pluginAlias": "HydronicHeating",
  "pluginType": "platform",
  "headerDisplay": "Thermostats are exposed as individual accessories",
  "singular": true,
  "schema": {
    "name": {
      "title": "Name",
      "type": "string",
      "required": true,
      "default": "Hydronic Heating" 
    },
    "redis":{
        "title":"Redis Server",
    "type":"object",
      "properties":{
        "host":{
          "title": "Host",
          "type": "string",
          "required": true,
          "default": "localhost",
            "format": "hostname"
        },
        "port":{
            "title":"Port",
            "type": "integer",
            "required": true,
            "default": 6379
        }
        }
    },
    "boostMinutes": {
      "title": "Boost Minutes",
      "type": "integer",
      "default": 60,
      "minimum": 5,
      "maximum": 240,
      "description": "How long the Boost switch stays on before it turns itself off."
    },
    "thermostats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties":{
          "name": { 
            "title": "Name",
            "type": "string",
            "placeholder": "Enter thermostat name...",
            "default": "Thermostat",
            "required": true
          },
          "path": {
            "title": "Device Path",
            "type": "string",
            "placeholer": "Enter sensor path...",
            "default": "/home/sensors/ABCD1234",
            "required": true
          },
          "boostMinutes": {
            "title": "Boost Minutes",
            "type": "integer",
            "minimum": 5,
            "maximum": 240,
            "description": "Overrides the platform value for this thermostat."
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "redis",
    "redis.host",
    "redis.port",
    "boostMinutes",
    {
      "key": "thermostats",
      "type": "array",
      "orderable": false,
      "buttonText": "Add Thermostat",
      "items" : [
        "thermostats[].name",
        "thermostats[].path",
        "thermostats[].boostMinutes"
      ]
    }
  ]
}
